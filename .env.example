# Read-only production source. Do not use a write-capable account.
PROD_MONGO_URI=mongodb://readonly_user:password@production-host:27017/

# Local development target. The script requires this exact local port.
DEV_MONGO_URI=mongodb://127.0.0.1:27019/
MONGO_HOST_PORT=27019

# MONGO_URI may be used instead of PROD_MONGO_URI for scripts that expect the
# conventional name. PROD_MONGO_URI takes precedence when both are present.
# MONGO_URI=mongodb://readonly_user:password@production-host:27017/